DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"

# CHANGE THIS WITH STRONG RANDOM STRING
JWT_SECRET="b87478603f82ebdf542a9babb9f71fa8fa995a92b31a7e02eabd5efa8fb203e6"

NOTI_TOKEN="iuogblkasndfkasghdfsd"
