# 'debug' | 'info' | 'warn' | 'error'
# If not set, use default log settings. 
# default NODE_ENV=production => info, NODE_ENV=development => debug
APP_LOG_LEVEL="info"

# ----------------------------------------------
# reverse proxy 가 X-Forwarded-For 뒤에 클라이언트 IP 를 append 하는 구성이면
# true (proxy_add_x_forwarded_for 계열). 기본(false)은 좌측값 사용.
TRUST_PROXY="false"
